# Copy to .env.local and fill in. Never commit real values.

# Postgres connection (Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Auth.js session signing (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-me

# Comma-separated allow-list for /admin
ADMIN_EMAILS=someone@example.com,another@example.com

# Sending email
RESEND_API_KEY=re_replace_me

# Sender
EMAIL_FROM="injily <hello@injily.com>"

# Where new-lead and new-case notifications go
TEAM_INBOX=team@example.com

# Salting IP hashes for rate limiting
IP_HASH_SALT=replace-me

# Absolute URLs in metadata and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
